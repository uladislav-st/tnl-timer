{
  "name": "nix-tracker",
  "version": "1.3.0",
  "description": "Local activity and event timer for Throne and Liberty: Nix",
  "main": "main.js",
  "author": "Nix Tracker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uladislav-st/tnl-timer.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node tests/amazon-schedule.test.js",
    "pack": "electron-builder --win portable",
    "dist": "electron-builder --win nsis portable",
    "release": "electron-builder --win nsis portable --publish always"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.nixtracker.app",
    "productName": "Nix Tracker",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "uladislav-st",
      "repo": "tnl-timer",
      "releaseType": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Nix-Tracker-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Nix-Tracker-Portable-${version}-${arch}.${ext}"
    },
    "extraMetadata": {
      "name": "nix-tracker"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
