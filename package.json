{
  "name": "nix-tracker",
  "version": "1.0.0",
  "description": "Local activity and event timer for Throne and Liberty: Nix",
  "main": "main.js",
  "author": "Nix Tracker",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.nixtracker.app",
    "productName": "Nix Tracker",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Nix-Tracker-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Nix-Tracker-Portable-${version}-${arch}.${ext}"
    },
    "extraMetadata": {
      "name": "nix-tracker"
    }
  }
}
